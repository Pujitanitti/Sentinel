NODE_ENV=development

# Gateway
GATEWAY_PORT=3000
BACKEND_URL=http://localhost:4000

# Demo API (the backend Sentinel protects)
DEMO_API_PORT=4000

# Dashboard
DASHBOARD_PORT=3001
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000

# Postgres — durable configuration, security events, request log history
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel

# Redis — rate-limit counters, risk scores, temporary blocks, request history
REDIS_URL=redis://localhost:6379

# Admin auth
JWT_SECRET=change-me-to-a-long-random-string-in-production
ADMIN_EMAIL=admin@sentinel.local
ADMIN_PASSWORD=changeme123

# What to do when Redis is unreachable: "fail-open" (allow requests) or "fail-closed" (block requests)
REDIS_FALLBACK_MODE=fail-open
